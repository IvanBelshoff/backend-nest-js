# Ambiente
NODE_ENV=development
PORT=3000

# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_USER=postgres
DB_PASS=change-me
DB_NAME=datadash
DB_PORT=5432
DB_POOL_MAX=20

# JWT e refresh token
JWT_SECRET=change-me-use-long-random-string
REFRESH_TOKEN_PEPPER=change-me-minimum-32-characters-long
SALT_ROUNDS=10

# CORS e cookies (frontend)
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Foto de perfil padrão
DEFAULT_PROFILE_PHOTO_NAME=profile.jpg
DEFAULT_PROFILE_PHOTO_LOCAL=shared/data/default/profile.jpg
DEFAULT_PROFILE_PHOTO_TYPE=image/jpeg

# Usuário seed (criado no primeiro startup se não existir)
NAME_USER_DEFAULT=Admin
SOBRENOME_USER_DEFAULT=Admin
EMAIL_USER_DEFAULT=admin@example.com
SENHA_USER_DEFAULT=ChangeMe123

# Sync de regras/permissões no bootstrap
SYNC_ROLES_ON_STARTUP=true

# Swagger UI em /docs (default: habilitado fora de production)
SWAGGER_ENABLED=true

# Regras e permissões (JSON). Copie também para o .env do frontend.
REGRAS_PERMISSOES={"REGRA_ADMIN":[],"REGRA_USUARIO":["PERMISSAO_CRIAR_USUARIO","PERMISSAO_ATUALIZAR_USUARIO","PERMISSAO_EXCLUIR_USUARIO","PERMISSAO_CONCEDER_ACESSO_DASHBOARD"],"REGRA_DASHBOARD":["PERMISSAO_CRIAR_DASHBOARD","PERMISSAO_ATUALIZAR_DASHBOARD","PERMISSAO_EXCLUIR_DASHBOARD","PERMISSAO_CONCEDER_ACESSO_USUARIO"]}
