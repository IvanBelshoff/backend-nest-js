# Ambiente
NODE_ENV=development
PORT=3000

# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_USER=postgres
DB_PASS=change-me
DB_NAME=datadash
DB_PORT=5432
# Em produção com 500+ usuários simultâneos, considere 50–100
DB_POOL_MAX=20

# MongoDB (snapshots offline e logs) — docker: datadash-mongo na porta 27017
MONGO_URI=mongodb://127.0.0.1:27017/datadash_reports
MONGO_DB_NAME=datadash_reports

# Criptografia de senhas de conexão (32 bytes em base64)
CONNECTION_ENCRYPTION_KEY=change-me-generate-32-bytes-base64-key==

# Relatórios - limites de execução
REPORT_QUERY_TIMEOUT_MS=600000
REPORT_QUERY_MAX_ROWS=10000

# Filas pg-boss (mesmo PostgreSQL; API + worker no mesmo processo)
PG_BOSS_ENABLED=true
PG_BOSS_SCHEMA=pgboss
REPORT_SNAPSHOT_QUEUE_NAME=report.snapshot.generate
REPORT_SNAPSHOT_QUEUE_CONCURRENCY=2
REPORT_SNAPSHOT_RETRY_LIMIT=3
REPORT_SNAPSHOT_RETRY_DELAY_SECONDS=60
REPORT_EXPORT_QUEUE_NAME=report.export.csv
REPORT_EXPORT_QUEUE_CONCURRENCY=3
REPORT_EXPORT_RETRY_LIMIT=2
SCHEDULER_DISPATCH_QUEUE_NAME=scheduler.dispatch
REPORT_EXPORT_DIR=src/shared/data/exports
REPORT_EXPORT_TTL_HOURS=24

# Snapshots analíticos (Parquet + DuckDB)
# STORAGE_DRIVER: onde os arquivos Parquet são armazenados (por enquanto apenas "local")
STORAGE_DRIVER=local
SNAPSHOT_STORAGE_DIR=src/shared/data/snapshots
# Compressão do Parquet: zstd | snappy | gzip | uncompressed
SNAPSHOT_PARQUET_COMPRESSION=zstd
# Tempo de vida para limpeza de Parquet órfãos (horas)
SNAPSHOT_TTL_HOURS=168
# Limite de consultas DuckDB simultâneas e timeout por consulta (ms)
DUCKDB_MAX_CONCURRENCY=2
DUCKDB_QUERY_TIMEOUT_MS=30000

# JWT e refresh token
JWT_SECRET=change-me-use-long-random-string
REFRESH_TOKEN_PEPPER=change-me-minimum-32-characters-long
SALT_ROUNDS=10

# CORS e cookies (frontend)
# Origens do frontend Electron/Vite (separadas por vírgula; credentials exige lista explícita)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Foto de perfil padrão
DEFAULT_PROFILE_PHOTO_NAME=profile.jpg
DEFAULT_PROFILE_PHOTO_LOCAL=shared/data/default/profile.jpg
DEFAULT_PROFILE_PHOTO_TYPE=image/jpeg

# Usuário seed (criado no primeiro startup se não existir)
NAME_USER_DEFAULT=Admin
SOBRENOME_USER_DEFAULT=Admin
EMAIL_USER_DEFAULT=admin@example.com
SENHA_USER_DEFAULT=ChangeMe123

# Sync de regras/permissões no bootstrap
SYNC_ROLES_ON_STARTUP=true

# Seed de dashboards genéricos no bootstrap (dev)
SEED_DASHBOARDS_ON_STARTUP=true

# Seed de usuários demo no bootstrap (dev)
SEED_USERS_ON_STARTUP=true
SENHA_USER_SEED_DEFAULT=SeedUser123

# Seed de relatórios demo no bootstrap (dev)
SEED_RELATORIOS_ON_STARTUP=false

# Swagger UI em /docs (default: habilitado fora de production)
SWAGGER_ENABLED=true

# Regras e permissões (JSON). Copie também para o .env do frontend.
REGRAS_PERMISSOES={"REGRA_ADMIN":[],"REGRA_USUARIO":["PERMISSAO_CRIAR_USUARIO","PERMISSAO_ATUALIZAR_USUARIO","PERMISSAO_EXCLUIR_USUARIO","PERMISSAO_CONCEDER_ACESSO_DASHBOARD","PERMISSAO_CONCEDER_ACESSO_RELATORIO"],"REGRA_DASHBOARD":["PERMISSAO_CRIAR_DASHBOARD","PERMISSAO_ATUALIZAR_DASHBOARD","PERMISSAO_EXCLUIR_DASHBOARD","PERMISSAO_CONCEDER_ACESSO_USUARIO"],"REGRA_RELATORIO":["PERMISSAO_CRIAR_RELATORIO","PERMISSAO_ATUALIZAR_RELATORIO","PERMISSAO_EXCLUIR_RELATORIO","PERMISSAO_CONCEDER_ACESSO_RELATORIO","PERMISSAO_CRIAR_CONEXAO","PERMISSAO_ATUALIZAR_CONEXAO","PERMISSAO_EXCLUIR_CONEXAO"]}
